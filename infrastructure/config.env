# ---------------------------------------------------------------------------
# face-e-demo configuration  (single source of truth for deploy + runtime)
# Used by: infrastructure/deploy.sh (resource names) and the Node/Express
#          backend (validation rules).  Edit here, then re-run deploy.sh.
# ---------------------------------------------------------------------------

# --- AWS -------------------------------------------------------------------
AWS_REGION=ap-south-1                 # MUST have Amazon Rekognition (ap-south-1 does; ap-south-2 does NOT)
PROJECT_NAME=face-e-demo
# Leave BUCKET_NAME empty to auto-generate a globally unique bucket name.
BUCKET_NAME=

# --- Rekognition face collection ------------------------------------------
COLLECTION_ID=org-members             # authorized organization-member face collection
FACE_MATCH_THRESHOLD=92               # SearchFacesByImage similarity % (spec: 90-95)
MAX_FACES_TO_SEARCH=1                 # matches returned per face query
MAX_FACES_TO_SCAN=10                  # max faces to detect + search individually (group photos)
EXTERNAL_IMAGE_ID_PREFIX=member-      # ExternalImageId prefix when enrolling

# --- Text / OCR rules ------------------------------------------------------
ALLOWED_ORG_TEXT=ACME,WIDGET-INDIA    # comma separated, organization related text
ORG_TEXT_MATCH_MODE=tokens            # tokens | substring
MIN_OCR_CONFIDENCE=60                 # drop OCR items below this
ALLOW_E_INSIDE_WORDS=false            # false = standalone "E" only (spec default)
COUNT_STANDALONE_E=true               # look for a standalone letter E at all

# --- Validation / scoring --------------------------------------------------
REQUIRE_FACE=true
REQUIRE_E=false
REQUIRE_ORG_TEXT=false
W_FACE=50                             # demo score weights (must total 100)
W_E=25
W_ORG_TEXT=25

# --- Upload limits ---------------------------------------------------------
PRESIGN_TTL_SECONDS=720               # 12 minutes (spec: 10-15)
MIN_UPLOAD_BYTES=40000                # ~40 KB floor; rejects empty/corrupt files
MAX_UPLOAD_BYTES=1048576              # 1 MB ceiling (spec: 300 KB - 1 MB target)
MAX_DIMENSION=1600                    # px, checked by the API (spec: 1280-1600)

# --- Processing ------------------------------------------------------------
SQS_MAX_RECEIVE_COUNT=3               # in-process attempts before a validation run gives up

# --- Frontend --------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173 # Vite dev server; change for hosted deploy
